# Turso / libSQL connection
#
# Local (default): leave TURSO_DATABASE_URL unset to use
#   file:<project>/data/collectibles.db
# Or set an explicit file URL, e.g.:
#   TURSO_DATABASE_URL=file:./data/collectibles.db
#
# Remote Turso (required on Vercel):
#   1. Create a DB at https://turso.tech
#   2. Copy the libsql:// URL and auth token
#   3. Set both vars in Vercel → Project → Settings → Environment Variables
#   4. Ingest once from your machine with the same env vars:
#        TURSO_DATABASE_URL=libsql://… TURSO_AUTH_TOKEN=… npm run db:ingest
#
# Optional Pokémon TCG API key (higher rate limits):
#   https://pokemontcg.io/ → X-Api-Key header
#   Works without a key at lower public limits.

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
POKEMONTCG_API_KEY=
